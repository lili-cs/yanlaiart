NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend transactional email — powers the /contact form.
# Get a server API key at https://resend.com/api-keys (free tier: 100 emails/day).
RESEND_API_KEY=re_xxx
# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=yichenhot@icloud.com
# Optional. Defaults to Resend's shared onboarding sender if unset.
# Must be a mailbox on a domain verified in Resend (icloud.com etc. can't be
# used as a sender). Customer replies are routed to CONTACT_TO_EMAIL via
# reply_to, so this is only the display "From" identity.
# CONTACT_FROM_EMAIL=Yan Lai Art <notifications@yanlaiart.com>

# Booking confirmation emails. Both are optional — if unset, the booking flow
# falls back to CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL above.
# BOOKING_TO_EMAIL=
# BOOKING_FROM_EMAIL=

# Website tech-support mailbox — receives suspicious-activity alerts and
# other operational notifications (e.g. booking bursts that look like abuse).
# Defaults to lili675846@gmail.com if unset.
# TECH_SUPPORT_EMAIL=lili675846@gmail.com

# ---- Admin (/admin) ----
# Initial credentials seeded on first read. Change ADMIN_INITIAL_PASSWORD before
# first startup for extra safety; you can also change the password from the
# Forgot-password flow once running.
ADMIN_USERNAME=yanlaiart
ADMIN_INITIAL_PASSWORD=yichen
# Signs admin session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Persistence ----
# The storage layer picks the first backend that has env vars set:
#   1. Neon Postgres (DATABASE_URL or POSTGRES_URL)
#   2. Vercel KV     (KV_REST_API_URL + KV_REST_API_TOKEN)
#   3. JSON files    (./data/, local dev only)
#
# Neon (recommended). Vercel's Neon integration adds DATABASE_URL / POSTGRES_URL
# automatically. Copy the same value into .env.local for local dev.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
#
# Vercel KV. Auto-added by the KV integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
